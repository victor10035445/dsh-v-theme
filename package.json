{
  "name": "dsh-v-theme",
  "description": "V CYBER — multi-colorway plugin for the DeepSeek Harness Web client: NEON baseline + five neon colorways (Sunset Drive / Dream Core / Neon Violet / Y2K Chrome / Blue Nocturne) and TACTICAL (SOC red/blue ops center)",
  "version": "0.7.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victor10035445/dsh-v-theme.git"
  },
  "bugs": {
    "url": "https://github.com/victor10035445/dsh-v-theme/issues"
  },
  "homepage": "https://github.com/victor10035445/dsh-v-theme#readme",
  "keywords": [
    "dsh",
    "deepseek-harness-web",
    "theme",
    "colorway",
    "cyberpunk",
    "neon",
    "synthwave",
    "y2k",
    "hud",
    "dark-theme"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node tests/smoke.cjs"
  }
}
